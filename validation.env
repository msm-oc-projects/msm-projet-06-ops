# Configuration Bash des scripts de validation.
#
# Il est chargé directement avec `source` par les scripts. La syntaxe reste
# proche d'un fichier .env, avec quelques expansions Bash pour calculer les
# chemins et URLs dérivés.
#
# Une variable définie avant le lancement garde la priorité grâce à la forme
# ${VARIABLE:-valeur_par_defaut}.

# Racine commune des dépôts.
PROJECT_ROOT="${PROJECT_ROOT:-$(cd -- "${SCRIPT_DIR}/.." && pwd)}"

# Noms des dépôts placés sous une racine commune.
BACKEND_PROJECT_NAME="${BACKEND_PROJECT_NAME:-msm-projet-06-backend}"
FRONTEND_PROJECT_NAME="${FRONTEND_PROJECT_NAME:-msm-projet-06-frontend}"
OPS_PROJECT_NAME="${OPS_PROJECT_NAME:-msm-projet-06-ops}"

# Projets parcourus par run-tests.sh, séparés par des espaces.
TEST_PROJECT_NAMES="${TEST_PROJECT_NAMES:-${BACKEND_PROJECT_NAME} ${FRONTEND_PROJECT_NAME}}"

# Chemins des dépôts.
BACKEND_DIR="${BACKEND_DIR:-${PROJECT_ROOT}/${BACKEND_PROJECT_NAME}}"
FRONTEND_DIR="${FRONTEND_DIR:-${PROJECT_ROOT}/${FRONTEND_PROJECT_NAME}}"
OPS_DIR="${OPS_DIR:-${PROJECT_ROOT}/${OPS_PROJECT_NAME}}"

# Versions minimales.
MIN_DOCKER_VERSION="${MIN_DOCKER_VERSION:-20.10}"
MIN_DOCKER_COMPOSE_VERSION="${MIN_DOCKER_COMPOSE_VERSION:-1.29}"
MIN_JAVA_VERSION="${MIN_JAVA_VERSION:-21}"
MIN_NODE_VERSION="${MIN_NODE_VERSION:-20.11}"
MIN_NPM_VERSION="${MIN_NPM_VERSION:-}"

# Ports.
DATABASE_PORT="${DATABASE_PORT:-5432}"
BACKEND_PORT="${BACKEND_PORT:-8080}"
FRONTEND_PORT="${FRONTEND_PORT:-4200}"
FRONTEND_DOCKER_PORT="${FRONTEND_DOCKER_PORT:-80}"

# Endpoints de contrôle.
BACKEND_HEALTH_PATH="${BACKEND_HEALTH_PATH:-/api/workshops}"
FRONTEND_HEALTH_PATH="${FRONTEND_HEALTH_PATH:-/}"
FRONTEND_ASSET_PATH="${FRONTEND_ASSET_PATH:-/assets/mock/olympic.json}"

# URLs calculées depuis les ports et chemins précédents.
BACKEND_URL="${BACKEND_URL:-http://localhost:${BACKEND_PORT}${BACKEND_HEALTH_PATH}}"
FRONTEND_URL="${FRONTEND_URL:-http://localhost:${FRONTEND_PORT}${FRONTEND_HEALTH_PATH}}"
FRONTEND_ASSET_URL="${FRONTEND_ASSET_URL:-http://localhost:${FRONTEND_PORT}${FRONTEND_ASSET_PATH}}"
DOCKER_FRONTEND_URL="${DOCKER_FRONTEND_URL:-http://localhost:${FRONTEND_DOCKER_PORT}${FRONTEND_HEALTH_PATH}}"
DOCKER_FRONTEND_ASSET_URL="${DOCKER_FRONTEND_ASSET_URL:-http://localhost:${FRONTEND_DOCKER_PORT}${FRONTEND_ASSET_PATH}}"

# Base PostgreSQL temporaire.
# Ces identifiants sont réservés au développement local. Ne placez jamais de
# secret de production dans ce fichier versionné.
DB_CONTAINER="${DB_CONTAINER:-workshops-db-validation}"
DB_IMAGE="${DB_IMAGE:-postgres:13}"
DB_USER="${DB_USER:-workshops_user}"
DB_PASSWORD="${DB_PASSWORD:-oc2024}"
DB_NAME="${DB_NAME:-workshopsdb}"
DB_CONTAINER_PORT="${DB_CONTAINER_PORT:-5432}"

# Projets Docker Compose de validation.
BACKEND_COMPOSE_PROJECT="${BACKEND_COMPOSE_PROJECT:-msm-validation-backend}"
FRONTEND_COMPOSE_PROJECT="${FRONTEND_COMPOSE_PROJECT:-msm-validation-frontend}"
BACKEND_COMPOSE_FILE="${BACKEND_COMPOSE_FILE:-${BACKEND_DIR}/docker-compose.yml}"
FRONTEND_COMPOSE_FILE="${FRONTEND_COMPOSE_FILE:-${FRONTEND_DIR}/docker-compose.yml}"

# Délais exprimés en nombre d'essais espacés de deux secondes.
DATABASE_WAIT_ATTEMPTS="${DATABASE_WAIT_ATTEMPTS:-30}"
BACKEND_WAIT_ATTEMPTS="${BACKEND_WAIT_ATTEMPTS:-60}"
FRONTEND_WAIT_ATTEMPTS="${FRONTEND_WAIT_ATTEMPTS:-60}"
ASSET_WAIT_ATTEMPTS="${ASSET_WAIT_ATTEMPTS:-10}"
DOCKER_BACKEND_WAIT_ATTEMPTS="${DOCKER_BACKEND_WAIT_ATTEMPTS:-90}"
DOCKER_FRONTEND_WAIT_ATTEMPTS="${DOCKER_FRONTEND_WAIT_ATTEMPTS:-60}"

# Fichiers et dossiers vérifiés.
BACKEND_BUILD_FILE="${BACKEND_BUILD_FILE:-${BACKEND_DIR}/build.gradle}"
BACKEND_WRAPPER="${BACKEND_WRAPPER:-${BACKEND_DIR}/gradlew}"
BACKEND_SOURCES_DIR="${BACKEND_SOURCES_DIR:-${BACKEND_DIR}/src/main/java}"
BACKEND_DOCKERFILE="${BACKEND_DOCKERFILE:-${BACKEND_DIR}/Dockerfile}"
BACKEND_DB_INIT_FILE="${BACKEND_DB_INIT_FILE:-${BACKEND_DIR}/db/00001_0.0.0_init_create.sql}"
BACKEND_CONFIG_FILE="${BACKEND_CONFIG_FILE:-${BACKEND_DIR}/src/main/resources/application.properties}"

FRONTEND_PACKAGE_FILE="${FRONTEND_PACKAGE_FILE:-${FRONTEND_DIR}/package.json}"
FRONTEND_LOCK_FILE="${FRONTEND_LOCK_FILE:-${FRONTEND_DIR}/package-lock.json}"
FRONTEND_SOURCES_DIR="${FRONTEND_SOURCES_DIR:-${FRONTEND_DIR}/src/app}"
FRONTEND_DOCKERFILE="${FRONTEND_DOCKERFILE:-${FRONTEND_DIR}/Dockerfile}"
FRONTEND_ENV_FILE="${FRONTEND_ENV_FILE:-${FRONTEND_DIR}/src/environments/environment.ts}"
FRONTEND_PROD_ENV_FILE="${FRONTEND_PROD_ENV_FILE:-${FRONTEND_DIR}/src/environments/environment.prod.ts}"
ANGULAR_PACKAGE="${ANGULAR_PACKAGE:-${FRONTEND_DIR}/node_modules/@angular/cli/package.json}"

OPS_TEST_SCRIPT="${OPS_TEST_SCRIPT:-${OPS_DIR}/run-tests.sh}"
OPS_CONFIG_FILE="${OPS_CONFIG_FILE:-${OPS_DIR}/validation.env}"
